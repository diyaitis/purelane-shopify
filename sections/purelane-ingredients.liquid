{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-ingredients.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'
-%}

<section class="pl-scope pl-sec pl-ingredients" id="{{ section.settings.anchor_id | default: 'ingredients' }}" data-section-id="{{ section.id }}" data-section-type="purelane-ingredients">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv">
      <div class="pl-panel-head">
        <h2 class="pl-d2">{{ section.settings.heading }}</h2>
        <div class="pl-rule"><i></i>{% render 'purelane-icon', icon: 'leaf' %}<i></i></div>
      </div>
      {%- if ingredient_blocks.size > 0 -%}
        <div class="pl-ing">
          {%- for block in ingredient_blocks -%}
            <div class="pl-ing-i" {{ block.shopify_attributes }}>
              <div class="pl-art">{% render 'purelane-icon-ingredient', icon: block.settings.icon %}</div>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Ingredients",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "ingredients" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sourced from nature" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "coconut", "label": "Coconut" },
            { "value": "orange", "label": "Orange peel" },
            { "value": "soapnut", "label": "Soap nut" },
            { "value": "neem", "label": "Neem" },
            { "value": "lemongrass", "label": "Lemongrass" }
          ],
          "default": "coconut"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Coconut" },
        { "type": "text", "id": "text", "label": "Text", "default": "Plant-derived cleansers that lift grease" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "icon": "coconut", "title": "Coconut", "text": "Plant-derived cleansers that lift grease" } },
        { "type": "ingredient", "settings": { "icon": "orange", "title": "Orange peel", "text": "Natural degreaser and fresh citrus lift" } },
        { "type": "ingredient", "settings": { "icon": "soapnut", "title": "Soap nut", "text": "A traditional plant foaming agent" } },
        { "type": "ingredient", "settings": { "icon": "neem", "title": "Neem", "text": "Time-tested antibacterial from the tree" } },
        { "type": "ingredient", "settings": { "icon": "lemongrass", "title": "Lemongrass", "text": "Clean fragrance with nothing synthetic" } }
      ]
    }
  ]
}
{% endschema %}
