{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-sticky-cta.css' | asset_url | stylesheet_tag }}

<div class="pl-scope pl-sticky" data-section-id="{{ section.id }}" data-section-type="purelane-sticky-cta">
  <span class="pl-lbl">
    <b>{{ section.settings.title }}</b>
    <span>{{ section.settings.subtitle }}</span>
  </span>
  <a class="pl-btn pl-btn-primary pl-btn-sm" href="{{ section.settings.link | default: '#bundles' }}">{{ section.settings.button_label | default: 'Shop now' }}</a>
</div>

{% schema %}
{
  "name": "Purelane: Sticky CTA",
  "tag": "div",
  "class": "pl-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Pick any 3, pay ₹499" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Free shipping, always" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Build bundle" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Purelane: Sticky CTA" }
  ]
}
{% endschema %}
