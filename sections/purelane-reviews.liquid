{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
-%}

<section class="pl-scope pl-sec pl-revband" id="{{ section.settings.anchor_id | default: 'reviews' }}" data-section-id="{{ section.id }}" data-section-type="purelane-reviews">
  <div class="pl-wrap">
    <div class="pl-revhead pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <span class="pl-agg"><span class="pl-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ section.settings.rating_text }}</span>
      {%- endif -%}
      {%- if section.settings.loved_by_text != blank -%}
        <span class="pl-agg">{{ section.settings.loved_by_text }}</span>
      {%- endif -%}
    </div>
  </div>

  {%- if review_blocks.size > 0 -%}
    <div class="pl-revrail pl-rv" aria-label="Customer reviews" tabindex="0">
      <div class="pl-revtrack">
        {%- for i in (1..2) -%}
          {%- for block in review_blocks -%}
            <article class="pl-glass-2 pl-rcard" {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
              <div class="pl-stars">
                {%- for star in (1..5) -%}{% if star <= block.settings.rating %}&#9733;{% else %}&#9734;{% endif %}{%- endfor -%}
              </div>
              <h5>{{ block.settings.title }}</h5>
              <p>{{ block.settings.body }}</p>
              <div class="pl-who">
                {% render 'purelane-icon', icon: 'check' %}
                <b>{{ block.settings.name }}</b>
                {%- if block.settings.source != blank -%}<span>&middot; {{ block.settings.source }}</span>{%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Purelane: Reviews rail",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor ID",
      "default": "reviews"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow text",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating summary",
      "default": "4.8 from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "loved_by_text",
      "label": "Secondary summary",
      "default": "Loved by 12 lakh+ homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Works like a charm" },
        { "type": "textarea", "id": "body", "label": "Review text", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Anita" },
        { "type": "text", "id": "source", "label": "Product / context", "default": "Laundry detergent" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Reviews rail",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "title": "Works like a charm", "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.", "name": "Anita", "source": "Laundry detergent" } },
        { "type": "review", "settings": { "rating": 5, "title": "Best dishwash ever", "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "name": "Priya", "source": "Dishwash gel" } },
        { "type": "review", "settings": { "rating": 5, "title": "Great product, great packaging", "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "name": "Sunita", "source": "Liquid handwash" } },
        { "type": "review", "settings": { "rating": 5, "title": "Dog friendly", "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "name": "Rohit S.", "source": "Floor cleaner" } },
        { "type": "review", "settings": { "rating": 5, "title": "Sparkling taps again", "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.", "name": "Verified buyer", "source": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}
