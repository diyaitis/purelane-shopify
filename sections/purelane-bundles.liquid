{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign tier_blocks = section.blocks | where: 'type', 'tier'
-%}

<section class="pl-scope pl-sec pl-bundles" id="{{ section.settings.anchor_id | default: 'bundles' }}" data-section-id="{{ section.id }}" data-section-type="purelane-bundles">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv" style="margin-bottom:16px">
      <div class="pl-panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="pl-lede" style="margin:0 auto">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if tier_blocks.size > 0 -%}
      <div class="pl-tiers">
        {%- for block in tier_blocks -%}
          {%- assign s = block.settings -%}
          {%- assign features = s.features | newline_to_br | split: '<br />' -%}
          {%- assign tier_product_count = 0 -%}
          {%- for n in (1..5) -%}
            {%- assign key = 'product_' | append: n -%}
            {%- if s[key] != blank -%}{%- assign tier_product_count = tier_product_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          <article class="pl-glass pl-tier pl-rv{% if s.is_best %} pl-tier--best pl-rv-d2{% endif %}" {{ block.shopify_attributes }}>
            {%- if s.tag != blank -%}<span class="pl-tag">{{ s.tag }}</span>{%- endif -%}
            {%- if tier_product_count > 0 -%}
              <div class="pl-tierpix{% if tier_product_count >= 5 %} pl-tierpix--five{% endif %}" aria-hidden="true">
                {%- for n in (1..5) -%}
                  {%- assign key = 'product_' | append: n -%}
                  {%- assign p = s[key] -%}
                  {%- if p != blank and p.featured_media != blank -%}
                    <img src="{{ p.featured_media | image_url: width: 160 }}" alt="" loading="lazy" width="80" height="80">
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="pl-qty">{{ s.qty }}<small>Products</small></div>
            <div class="pl-price">{{ s.price }} {%- if s.compare_price != blank -%}<s>{{ s.compare_price }}</s>{%- endif -%}</div>
            {%- if s.per_product_note != blank -%}<p class="pl-body-s" style="font-size:12px">{{ s.per_product_note }}</p>{%- endif -%}
            {%- if features.size > 0 -%}
              <ul>
                {%- for feature in features -%}
                  {%- if feature != blank -%}
                    <li>{% render 'purelane-icon', icon: 'check' %}{{ feature | strip }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <a class="pl-btn {% if s.is_best %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}" href="{{ s.button_link | default: '#shop' }}">
              {{ s.button_label | default: 'Build this box' }}
              {%- if s.is_best -%}{% render 'purelane-icon', icon: 'arrow' %}{%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Bundles",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "bundles" },
    { "type": "text", "id": "kicker", "label": "Eyebrow text", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "text", "id": "qty", "label": "Product quantity", "default": "2" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹349" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price", "default": "₹598" },
        { "type": "text", "id": "per_product_note", "label": "Per-product note", "default": "Flat ₹174 per product" },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "Pick any two products\nFree shipping across India" },
        { "type": "checkbox", "id": "is_best", "label": "Highlight as most popular", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Build this box" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Thumbnail products (up to 5)" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3" },
        { "type": "product", "id": "product_4", "label": "Product 4" },
        { "type": "product", "id": "product_5", "label": "Product 5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Bundles",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter", "qty": "2", "price": "₹349", "compare_price": "₹598", "per_product_note": "Flat ₹174 per product", "features": "Pick any two products\nFree shipping across India" } },
        { "type": "tier", "settings": { "tag": "Most popular", "qty": "3", "price": "₹499", "compare_price": "₹897", "per_product_note": "Flat ₹166 per product", "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India", "is_best": true } },
        { "type": "tier", "settings": { "tag": "Whole home", "qty": "5", "price": "₹799", "compare_price": "₹1495", "per_product_note": "Flat ₹160 per product", "features": "Pick any five products\nEvery room in one order\nFree shipping across India" } }
      ]
    }
  ]
}
{% endschema %}
