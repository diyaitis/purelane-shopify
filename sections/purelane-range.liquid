{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-range.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

<section class="pl-scope pl-sec pl-range-sec" id="{{ section.settings.anchor_id | default: 'range' }}" data-section-id="{{ section.id }}" data-section-type="purelane-range">
  <div class="pl-wrap">
    <div class="pl-glass pl-range pl-rv">
      <div class="pl-range-head">
        <div>
          {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
          <h2 class="pl-d2" style="margin-top:10px">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.text != blank -%}
          <p class="pl-body-s" style="max-width:34ch;margin-bottom:4px">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <div class="pl-stripwrap">
          <div class="pl-rangerow">
            {%- for product in section.settings.collection.products limit: 14 -%}
              {%- if product.featured_media != blank -%}
                <img src="{{ product.featured_media | image_url: width: 260 }}" alt="{{ product.title | escape }}" loading="lazy" width="130" height="130">
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <p class="pl-striphint">Swipe to see the full shelf</p>
      {%- elsif request.design_mode -%}
        <p class="pl-body-s">Select a collection in this section's settings.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Full range",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "range" },
    { "type": "text", "id": "kicker", "label": "Eyebrow text", "default": "The full range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every room, one shelf" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Floors, taps, kitchen, laundry, bathroom and hands. Plant-based formulas that replace every harsh bottle under your sink." },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [
    { "name": "Purelane: Full range" }
  ]
}
{% endschema %}
