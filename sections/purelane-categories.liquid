{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-categories.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign category_blocks = section.blocks | where: 'type', 'category'
-%}

<section class="pl-scope pl-sec pl-categories-sec" id="{{ section.settings.anchor_id | default: 'categories' }}" data-section-id="{{ section.id }}" data-section-type="purelane-categories">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>
    {%- if category_blocks.size > 0 -%}
      <div class="pl-cats">
        {%- for block in category_blocks -%}
          {%- assign img = block.settings.product.featured_media | default: block.settings.image -%}
          <a class="pl-glass pl-cat pl-rv{% if forloop.index > 1 %} pl-rv-d{{ forloop.index }}{% endif %}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
            <span class="pl-ph">
              {%- if img != blank -%}
                <img src="{{ img | image_url: width: 320 }}" alt="" loading="lazy" width="160" height="160">
              {%- endif -%}
            </span>
            <span class="pl-txt">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Categories",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "categories" },
    { "type": "text", "id": "kicker", "label": "Eyebrow text", "default": "Bundle categories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right bundle for you" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (for image)" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen bundle" },
        { "type": "text", "id": "text", "label": "Text", "default": "Grease, dishes & more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Kitchen bundle", "text": "Grease, dishes & more", "link": "#combos" } },
        { "type": "category", "settings": { "title": "Bathroom bundle", "text": "Deep clean & disinfect", "link": "#combos" } },
        { "type": "category", "settings": { "title": "Laundry bundle", "text": "Softer, fresher wash", "link": "#combos" } },
        { "type": "category", "settings": { "title": "Hard water bundle", "text": "Melt away limescale", "link": "#combos" } }
      ]
    }
  ]
}
{% endschema %}
