{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-signup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

<section class="pl-scope pl-sec pl-signup-sec" data-section-id="{{ section.id }}" data-section-type="purelane-signup">
  <div class="pl-wrap">
    <div class="pl-glass pl-signup pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="pl-lede" style="margin:0 auto">{{ section.settings.text }}</p>{%- endif -%}

      {%- form 'customer', class: 'pl-signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="PurelaneSignupEmail-{{ section.id }}">Email address</label>
        <input
          id="PurelaneSignupEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="your@email.com"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="PurelaneSignupError-{{ section.id }}"{% endif %}
        >
        <button class="pl-btn pl-btn-primary" type="submit">{{ section.settings.button_label | default: 'Sign up' }}</button>

        {%- if form.errors -%}
          <p class="pl-form-message pl-form-message--error" id="PurelaneSignupError-{{ section.id }}" role="alert">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- elsif form.posted_successfully? -%}
          <p class="pl-form-message pl-form-message--success" role="status">Thanks — you're on the list.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Signup",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Eyebrow text", "default": "Join the Purelane Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "text", "id": "text", "label": "Text", "default": "Plus first access to new launches and restocks." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get my ₹100 off" }
  ],
  "presets": [
    { "name": "Purelane: Signup" }
  ]
}
{% endschema %}
