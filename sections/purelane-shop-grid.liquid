{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign products_to_display = section.settings.products_to_show
  if section.settings.collection.all_products_count < section.settings.products_to_show
    assign products_to_display = section.settings.collection.all_products_count
  endif
-%}

<section class="pl-scope pl-sec pl-shop" id="{{ section.settings.anchor_id | default: 'shop' }}" data-section-id="{{ section.id }}" data-section-type="purelane-shop-grid">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    {%- if section.settings.collection != blank and products_to_display > 0 -%}
      <div class="pl-shelf">
        {%- for product in section.settings.collection.products limit: products_to_display -%}
          {%- render 'purelane-product-card', card_product: product -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="pl-body-s" style="text-align:center">Select a collection with 8+ products in this section's settings to show real products here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Shop grid",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor ID",
      "default": "shop",
      "info": "Used for on-page links like #shop, e.g. from the nav or the hero \"Shop now\" button."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products shown come entirely from this collection — nothing here is hardcoded. Include sold-out, no-image, and long-title products to see how the card adapts."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane: Shop grid"
    }
  ]
}
{% endschema %}
