{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-pillars.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign pillar_blocks = section.blocks | where: 'type', 'pillar'
-%}

<section class="pl-scope pl-sec pl-pillars-sec" id="{{ section.settings.anchor_id | default: 'how' }}" data-section-id="{{ section.id }}" data-section-type="purelane-pillars">
  <div class="pl-wrap">
    {%- if pillar_blocks.size > 0 -%}
      <div class="pl-pillars">
        {%- for block in pillar_blocks -%}
          <article class="pl-glass pl-pillar pl-rv{% if forloop.index > 1 %} pl-rv-d{{ forloop.index }}{% endif %}" {{ block.shopify_attributes }}>
            <span class="pl-pi">{% render 'purelane-icon', icon: block.settings.icon %}</span>
            <h3 class="pl-d3">{{ block.settings.title }}</h3>
            <p class="pl-body-s">{{ block.settings.text }}</p>
            {%- if block.settings.link_label != blank -%}
              <a class="pl-btn pl-btn-ghost pl-btn-sm" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Pillars",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "how" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "dots", "label": "Dots" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "dots"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Less scrubbing" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "dots", "title": "Less scrubbing", "text": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.", "link_label": "Learn more", "link": "#shop" } },
        { "type": "pillar", "settings": { "icon": "shield", "title": "Clean ingredients", "text": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.", "link_label": "Learn more", "link": "#ingredients" } },
        { "type": "pillar", "settings": { "icon": "heart", "title": "Safe around everyone", "text": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.", "link_label": "Learn more", "link": "#proof" } }
      ]
    }
  ]
}
{% endschema %}
