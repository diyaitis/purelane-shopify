{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-whybundles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign reason_blocks = section.blocks | where: 'type', 'reason'
-%}

<section class="pl-scope pl-sec pl-whybundles-sec" id="{{ section.settings.anchor_id | default: 'whybundles' }}" data-section-id="{{ section.id }}" data-section-type="purelane-whybundles">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv">
      <div class="pl-panel-head">
        {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      </div>
      {%- if reason_blocks.size > 0 -%}
        <div class="pl-wb">
          {%- for block in reason_blocks -%}
            <div class="pl-wb-i" {{ block.shopify_attributes }}>
              <span class="pl-ci">{% render 'purelane-icon', icon: block.settings.icon %}</span>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Why bundles",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "whybundles" },
    { "type": "text", "id": "kicker", "label": "Eyebrow text", "default": "The smarter way to shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why bundles beat buying single" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "percent", "label": "Percent" },
            { "value": "checksquare", "label": "Check square" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "percent"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Save up to 45%" },
        { "type": "text", "id": "text", "label": "Text", "default": "Versus buying the same products separately" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Why bundles",
      "blocks": [
        { "type": "reason", "settings": { "icon": "percent", "title": "Save up to 45%", "text": "Versus buying the same products separately" } },
        { "type": "reason", "settings": { "icon": "checksquare", "title": "One flat price", "text": "No calculators, no comparing carts" } },
        { "type": "reason", "settings": { "icon": "star", "title": "Curated by experts", "text": "Products picked to work well together" } },
        { "type": "reason", "settings": { "icon": "truck", "title": "Free shipping always", "text": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}
