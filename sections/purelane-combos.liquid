{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign combo_blocks = section.blocks | where: 'type', 'combo'
-%}

<section class="pl-scope pl-sec pl-combos" id="{{ section.settings.anchor_id | default: 'combos' }}" data-section-id="{{ section.id }}" data-section-type="purelane-combos">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule"><i></i>{% render 'purelane-icon', icon: 'leaf' %}<i></i></div>
      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if combo_blocks.size > 0 -%}
      <div class="pl-comborail pl-rv">
        {%- for block in combo_blocks -%}
          {%- assign s = block.settings -%}
          <article class="pl-glass pl-combo{% if s.is_best_value %} pl-combo--hero{% endif %}" {{ block.shopify_attributes }}>
            <div class="pl-tray">
              {%- if s.save_text != blank -%}<span class="pl-save">{{ s.save_text }}</span>{%- endif -%}
              {%- if s.flag_text != blank -%}<span class="pl-flag">{{ s.flag_text }}</span>{%- endif -%}
              <div class="pl-stack">
                {%- for n in (1..3) -%}
                  {%- assign item_product_key = 'item_' | append: n | append: '_product' -%}
                  {%- assign item_label_key = 'item_' | append: n | append: '_label' -%}
                  {%- assign item_product = s[item_product_key] -%}
                  {%- assign item_label = s[item_label_key] -%}
                  {%- if item_label != blank -%}
                    {%- if n > 1 -%}<span class="pl-plus" aria-hidden="true">+</span>{%- endif -%}
                    <span class="pl-it">
                      {%- if item_product != blank and item_product.featured_media != blank -%}
                        <img src="{{ item_product.featured_media | image_url: width: 200 }}" alt="" loading="lazy" width="100" height="100">
                      {%- else -%}
                        <span class="pl-tile">{% render 'purelane-icon', icon: 'leaf' %}</span>
                      {%- endif -%}
                      <span>{{ item_label }}</span>
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="pl-combo-body">
              <h3>{{ s.title }}</h3>
              {%- if s.product_count != blank -%}<div class="pl-cnt">{{ s.product_count }}</div>{%- endif -%}
              {%- if s.description != blank -%}<p class="pl-inc">{{ s.description }}</p>{%- endif -%}
              <div class="pl-prow">
                <strong>{{ s.price }}</strong>
                {%- if s.compare_price != blank -%}<s>{{ s.compare_price }}</s>{%- endif -%}
                {%- if s.save_text != blank -%}<em>{{ s.save_text }}</em>{%- endif -%}
              </div>
              {%- if s.fine_print != blank -%}<div class="pl-fine">{{ s.fine_print }}</div>{%- endif -%}
              <a class="pl-btn {% if s.is_best_value %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}" href="{{ s.button_link | default: '#bundles' }}">
                {{ s.button_label | default: 'Shop bundle' }}
                {% render 'purelane-icon', icon: 'arrow' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="pl-swipecue" aria-hidden="true">{% render 'purelane-icon', icon: 'arrow' %}Swipe for more combos</div>
      {%- if section.settings.footnote != blank -%}
        <p class="pl-railnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Combos",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "combos" },
    { "type": "text", "id": "kicker", "label": "Eyebrow text", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen essentials" },
        { "type": "text", "id": "product_count", "label": "Product count label", "default": "3 products" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately." },
        { "type": "text", "id": "price", "label": "Price", "default": "₹499" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price", "default": "₹897" },
        { "type": "text", "id": "save_text", "label": "Save badge text", "default": "Save ₹398" },
        { "type": "text", "id": "flag_text", "label": "Corner flag text (optional)", "info": "e.g. \"Most popular\". Leave blank for none." },
        { "type": "checkbox", "id": "is_best_value", "label": "Highlight as best value", "default": false },
        { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Inclusive of all taxes · COD available" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop bundle" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Stack item 1" },
        { "type": "product", "id": "item_1_product", "label": "Product (for thumbnail)" },
        { "type": "text", "id": "item_1_label", "label": "Caption", "default": "Cuts grease instantly" },
        { "type": "header", "content": "Stack item 2" },
        { "type": "product", "id": "item_2_product", "label": "Product (for thumbnail)" },
        { "type": "text", "id": "item_2_label", "label": "Caption", "default": "Squeaky clean dishes" },
        { "type": "header", "content": "Stack item 3 (optional)" },
        { "type": "product", "id": "item_3_product", "label": "Product (for thumbnail)" },
        { "type": "text", "id": "item_3_label", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane: Combos",
      "blocks": [
        { "type": "combo", "settings": { "title": "Kitchen essentials", "product_count": "3 products", "price": "₹499", "compare_price": "₹897", "save_text": "Save ₹398", "flag_text": "Most popular", "item_1_label": "Cuts grease instantly", "item_2_label": "Squeaky clean dishes", "item_3_label": "Melts hard water stains" } },
        { "type": "combo", "settings": { "title": "Complete home bundle", "product_count": "5 products", "price": "₹799", "compare_price": "₹1,495", "save_text": "Save ₹696", "flag_text": "Best value", "is_best_value": true, "item_1_label": "Cuts grease instantly", "item_2_label": "Kills 99.9% germs", "item_3_label": "Gentle hydration for hands" } }
      ]
    }
  ]
}
{% endschema %}
